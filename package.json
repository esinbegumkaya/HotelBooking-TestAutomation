{
  "name": "hotel-booking-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "npm run start --prefix api",
    "ui": "npm run dev --prefix ui",
    "ui:build": "npm run build --prefix ui",
    "dev": "concurrently -k \"npm:api\" \"npm:ui\"",
    "start:api": "npm run api",
    "test:ui": "npm test --prefix selenium",
    "test:api": "node scripts/run-newman.js",
    "test:all": "npm run test:api && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:performance": "node scripts/performance-smoke.js",
    "test:ci": "npm run test:unit && npm run test:api && npm run test:ui"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "newman": "^6.2.1"
  }
}
